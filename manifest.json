{
  "manifest_version": 3,
  "name": "Bing Daily Wallpaper for ChromeOS",
  "description": "Set your ChromeOS wallpaper to the daily Bing image in full resolution.",
  "version": "1.0.0",
  "permissions": ["wallpaper", "storage", "alarms"],
  "host_permissions": ["https://www.bing.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Bing Wallpaper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/WallpaperGlyph.png",
      "48": "icons/WallpaperGlyph.png",
      "128": "icons/WallpaperGlyph.png"
    }
  },
  "icons": {
    "16": "icons/WallpaperGlyph.png",
    "48": "icons/WallpaperGlyph.png",
    "128": "icons/WallpaperGlyph.png"
  }
}
